#!/usr/bin/env bash
set -e
cd -- "$(dirname -- "$0")"
: "${WM_PROJECT_DIR:?Activate OpenFOAM first}"
: "${MODEL_DIR:?Set MODEL_DIR to the exported AOTInductor model folder}"
export PATH="$PWD/../build/bin:$PATH"
export LD_LIBRARY_PATH="$PWD/../build/lib:${TORCH_LIBRARIES}/lib:$LD_LIBRARY_PATH"
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
for model in ub r ut; do
    ln -sfn "${MODEL_DIR}/${model}.pt2" "${model}.pt2"
done
if [ -d 0 ]; then
    echo 'A run already exists. Copy a fresh case for each comparison.' >&2
    exit 1
fi
cp -r 0.org 0
runApplication blockMesh
runApplication "$(getApplication)"
./Allpost -noZero > log.sherwood 2>&1
touch post.foam
